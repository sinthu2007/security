# ----------------------------------------------------------------------------
# AegisGuard AI - Application Configuration Template
# ----------------------------------------------------------------------------

# Execution Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Backend Server Listening Port
PORT=5000

# Client Web Application URL (Allowed CORS Origin)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or Local Daemon)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aegisguard?retryWrites=true&w=majority
# In development, an automated in-memory MongoDB will initialize if this connection is unreachable.
MONGODB_URI=mongodb://127.0.0.1:27017/aegisguard_security

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=aegisguard-super-secure-production-jwt-secret-key-998877
JWT_EXPIRES_IN=7d

# Redis Distributed Queue Connection String
# Leave empty in local development to run the built-in asynchronous worker queue.
# REDIS_URL=redis://127.0.0.1:6379

# Initial System Administrator Credentials
# Automatically seeded into database on first startup if no admin exists
ADMIN_EMAIL=admin@aegisguard.security
ADMIN_PASSWORD=Admin@Security2025!
ADMIN_NAME=Security Operations Center Admin

# Worker Concurrency Settings
SCAN_CONCURRENCY=3
REQUEST_TIMEOUT_MS=12000
